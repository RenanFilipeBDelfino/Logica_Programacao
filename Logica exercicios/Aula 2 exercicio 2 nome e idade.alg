algoritmo "Aula 2"
// Função : Exercicio 2 nome e idade
// Autor :  Renan Delfino
// Data : 10/09/2026
// Seção de Declarações 
var
   Nome: Caractere
   Idade: Inteiro
   
  inicio
      escreval (" Seja bem vindo ")
      escreva (" digite seu nome ")
      Leia(nome)
      escreva (" digite sua idade ")
      Leia(idade)
fimalgoritmo
