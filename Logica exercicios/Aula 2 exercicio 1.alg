algoritmo "Aula 2 Variaveis e primeiro programas"
// Fun??o : programa para pedir o nome do usuario e dar boas vindas ao usuario
// Autor : Renan Delfino
// Data : 08/09/2026
// Se??o de Declara??es
var
   nome: caractere
inicio
      escreva ("digite seu nome: ")
      leia(nome)
      escreval ("boas-vindas: " ,nome )

fimalgoritmo
