algoritmo "Aula 3 Exercicio 1"
// Função : somar numeros e mostrar resultado
// Autor :  renan delfino
// Data : 11/09/2026
// Seção de Declarações 
var
   x,y: inteiro
inicio
      escreva(" Informe um numero: ")
      Leia(x)
      escreva(" informe um outro numero: ")
      Leia(y)
      escreva("a soma e:",x+y)
fimalgoritmo
