algoritmo "Aula 2 Variaveis e primeiro programas"
// Função : Exercicio 1 guarde seu nome
// Autor : Renan Delfino
// Data : 08/09/2026
// Seção de Declarações 
var
   nome: caractere
inicio
      escreval (" Seja bem vindo ")
      Escreva ("digite seu nome: ")
      Leia(nome)
      
fimalgoritmo
