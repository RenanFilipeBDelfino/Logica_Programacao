algoritmo "Aula 3 Exercicio 4"
// Função : media de duas notas
// Autor : Renan Delfino
// Data : 17/09/2026
// Seção de Declarações 
var
   N1, N2, M: Real
inicio
      escreva(" Primeira Nota ")
      leia(N1)
      escreva(" Segunda Nota ")
      leia(N2)
      M <- (N1 + N2) / 2
      escreval(" A media do aluno foi " , M:4:2)

fimalgoritmo
